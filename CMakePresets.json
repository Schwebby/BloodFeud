{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Windows release (SKSE plugin, newest installed Visual Studio)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "BUILD_TESTING": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "tests",
      "displayName": "Core + tests only (any OS)",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "tests", "configurePreset": "tests" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "tests", "configurePreset": "tests", "output": { "outputOnFailure": true } }
  ]
}
